@API_HostAddress = https://localhost:5001

### ---------- Account ----------

### Register a new user
POST {{API_HostAddress}}/api/account/register
Content-Type: application/json
Accept: application/json

{
  "displayName": "Tom",
  "email": "Turnchill@test.com",
  "password": "letmein"
}

### Login (run this first - its token is used by the requests marked [Authorize])
# @name login
POST {{API_HostAddress}}/api/account/login
Content-Type: application/json
Accept: application/json

{
  "email": "bob@test.com",
  "password": "Password"
}

### Login with the wrong password (expect 401)
POST {{API_HostAddress}}/api/account/login
Content-Type: application/json
Accept: application/json

{
  "email": "bob@test.com",
  "password": "WrongPassword"
}

### ---------- Members ----------

### Get all members
GET {{API_HostAddress}}/api/members
Accept: application/json

### Get a single member by id [Authorize] (Bob)
GET {{API_HostAddress}}/api/members/c9f1befc-acc3-4a45-9ceb-b7ab3f7a4a3b
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### Get a single member without a token (expect 401)
GET {{API_HostAddress}}/api/members/c9f1befc-acc3-4a45-9ceb-b7ab3f7a4a3b
Accept: application/json

### Get a member that doesn't exist [Authorize] (expect 404)
GET {{API_HostAddress}}/api/members/does-not-exist
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### ---------- Buggy (error handling tests) ----------

### Unauthorized (expect 401)
GET {{API_HostAddress}}/api/buggy/auth
Accept: application/json

### Not found (expect 404)
GET {{API_HostAddress}}/api/buggy/not-found
Accept: application/json

### Server error (expect 500)
GET {{API_HostAddress}}/api/buggy/server-error
Accept: application/json

### Bad request (expect 400)
GET {{API_HostAddress}}/api/buggy/bad-request
Accept: application/json
